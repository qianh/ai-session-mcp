{
  "name": "brainhub-mcp",
  "version": "0.4.0",
  "license": "Apache-2.0",
  "description": "Local-first BrainHub MCP server for personal Google Drive sessions",
  "keywords": [
    "brainhub",
    "mcp",
    "google-drive",
    "ai-sessions"
  ],
  "homepage": "https://github.com/qianh/ai-session-mcp#readme",
  "bugs": {
    "url": "https://github.com/qianh/ai-session-mcp/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qianh/ai-session-mcp.git"
  },
  "files": [
    "dist",
    "plugins",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "bin": {
    "brainhub-mcp": "dist/cli/index.js"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "prebuild": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "tsc -p tsconfig.json",
    "build:release": "pnpm build && node scripts/inject-official-oauth.mjs",
    "dev": "tsx src/cli/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.test.json",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "pack:check": "npm pack --dry-run --ignore-scripts",
    "verify": "pnpm test && pnpm typecheck && pnpm lint && pnpm format:check && pnpm build && pnpm pack:check",
    "prepublishOnly": "pnpm verify && pnpm build:release"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "@iarna/toml": "^2.2.5",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "better-sqlite3": "^12.11.1",
    "commander": "^15.0.0",
    "fast-glob": "^3.3.3",
    "googleapis": "^173.0.0",
    "open": "^11.0.0",
    "sharp": "0.34.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.0.0",
    "eslint": "^10.7.0",
    "prettier": "^3.9.5",
    "tsx": "^4.23.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.64.0",
    "vitest": "^4.1.10"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild",
      "onnxruntime-node",
      "protobufjs",
      "sharp"
    ]
  },
  "release": {
    "branches": [
      "master"
    ]
  }
}
